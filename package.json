{
	"name": "taminhtienhai.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"favicon": "cp ./assets/favicon.png ./static/favicon.png",
		"dev": "bun vite dev",
		"prebuild": "bun scripts/build.mjs && bun favicon",
		"build": "bun run prebuild && bun vite build",
		"preview": "bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"test": "vitest"
	},
	"dependencies": {
		"change-case": "^5.4.4",
		"lit-html": "^3.3.2",
		"runed": "^0.37.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.2.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"build-src": "workspace:*",
		"daisyui": "^5.5.18",
		"oxfmt": "^0.28.0",
		"oxlint": "^1.43.0",
		"svelte": "^5.50.0",
		"svelte-check": "^4.3.6",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-motion": "^1.1.1",
		"vite": "^8.0.0-beta.13",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"typescript": "^5.9.2"
	},
	"workspaces": ["buildsrc"]
}
